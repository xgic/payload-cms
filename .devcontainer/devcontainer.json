{
  "name": "XGIC Payload CMS",
  "image": "ghcr.io/xgic/payload-cms-dev:0.3.0",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "node",
  // Lifecycle: prefer explicit XGIC CLI (no host initializeCommand).
  // First run inside the container:
  //   xgic payload env --regenerate --yes   # if .devcontainer/.env is missing
  //   xgic payload setup
  //   xgic up --profile postgres            # when using Compose DB sidecars
  //   xgic payload dev
  "customizations": {
    "vscode": {
      "extensions": [
        "bradlc.vscode-tailwindcss",
        "christian-kohler.npm-intellisense",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "GraphQL.vscode-graphql",
        "ms-vscode.vscode-typescript-next",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "streetsidesoftware.code-spell-checker",
        "usernamehw.errorlens"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Payload / Next.js",
      "onAutoForward": "notify"
    }
  }
}
